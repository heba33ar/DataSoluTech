#Copy this file to .env and change the passwords. .env is never committed.

#Root MongoDB account. Docker Compose passes it to the MongoDB image, which creates
#the account and enables authentication. Only done when the data volume is empty,
#so run `docker compose down -v` after changing it.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me

#Password shared by the three role accounts. If empty, they are not created.
MONGO_APP_PASSWORD=change_me_too

#Where to reach MongoDB. Docker Compose replaces this with mongodb:27017.
MONGO_HOST=localhost:27017
